# HostPog configuration. Copy to .env and fill in. Never commit .env.

# --- Core -------------------------------------------------------------------
# Public URL users open in the browser (used for cookies, CSRF origin checks, OAuth).
HOSTPOG_PUBLIC_URL=http://localhost:3000
# Browser-facing URL of the ingestion service (shown in SDK snippets).
HOSTPOG_INGEST_PUBLIC_URL=http://localhost:3001
NEXT_PUBLIC_HOSTPOG_INGEST_URL=http://localhost:3001

# 32-byte key for encrypting credentials at rest: openssl rand -base64 32
HOSTPOG_MASTER_KEY=
HOSTPOG_MASTER_KEY_VERSION=1
# During rotation, keep the previous key here until credentials are re-encrypted.
# HOSTPOG_MASTER_KEY_PREVIOUS=
# HOSTPOG_MASTER_KEY_PREVIOUS_VERSION=

# Session signing secret: openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# --- Datastores (matches infra/docker-compose.yml dev defaults) -------------
# Host ports used by `pnpm infra:up`. Change them if something else already uses the port,
# and keep the URLs below in sync.
POSTGRES_PORT=5433
CLICKHOUSE_HTTP_PORT=8123
REDIS_PORT=6379
DATABASE_URL=postgres://hostpog:hostpog_dev_only@localhost:5433/hostpog
CLICKHOUSE_URL=http://localhost:8123
CLICKHOUSE_USER=hostpog
CLICKHOUSE_PASSWORD=hostpog_dev_only
CLICKHOUSE_DB=hostpog
REDIS_URL=redis://localhost:6379

# --- Event store backend ------------------------------------------------------
# clickhouse (default, self-host) or tinybird (hosted; managed ClickHouse, free plan available).
# With tinybird, deploy the schema once with `tinybird deploy` (see lib/tinybird.ts).
HOSTPOG_EVENTS_BACKEND=tinybird
TINYBIRD_URL=
TINYBIRD_TOKEN=

# --- Background jobs -----------------------------------------------------------
# inline (default): history imports run inside the web process (self-host, long-running server).
# worker: the web app only queues jobs; the ingest server runs them next to Postgres (serverless hosting, e.g. Vercel).
HOSTPOG_JOB_RUNNER=inline
# Shared secret for web → ingest internal calls (worker mode). openssl rand -base64 32
HOSTPOG_INTERNAL_TOKEN=

# --- Ingestion --------------------------------------------------------------
INGEST_PORT=3001
HOSTPOG_INGEST_RATE_PER_MINUTE=1200

# --- PostHog connector -------------------------------------------------------
# Comma-separated origins of self-hosted PostHog instances users may connect to.
HOSTPOG_POSTHOG_ALLOWED_HOSTS=
# Fraction (0-1] of PostHog's documented per-key limits HostPog may use.
HOSTPOG_POSTHOG_BUDGET_FRACTION=0.8
# OAuth needs HOSTPOG_PUBLIC_URL to be public HTTPS (PostHog fetches the client metadata document).
HOSTPOG_POSTHOG_OAUTH_ENABLED=false

# --- AI (BYOK) --------------------------------------------------------------
# Hostnames of private/local model endpoints the operator allows (e.g. localhost for Ollama).
HOSTPOG_AI_ALLOWED_PRIVATE_HOSTS=

# --- Optional live smoke test (never committed) ----------------------------
# Personal API key (phx_…) for a TEST project, read-only scopes. Region auto-detected if unset.
# POSTHOG_SMOKE_API_KEY=
# POSTHOG_SMOKE_REGION=us
# Project token (phc_…) — public capture token; reserved for the upcoming migration/forwarding tests.
# POSTHOG_PROJECT_TOKEN=

# Hosted marketing site only: count site visits with a HostPog project (both must be set; leave empty when self-hosting).
NEXT_PUBLIC_SITE_ANALYTICS_KEY=
NEXT_PUBLIC_SITE_ANALYTICS_HOST=
